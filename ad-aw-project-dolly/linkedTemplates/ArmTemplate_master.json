{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "ad-aw-project-dolly"
		},
		"AzureDataLakeStorage_Linkedservice_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'AzureDataLakeStorage_Linkedservice'"
		},
		"GitHub_service_credential": {
			"type": "secureString",
			"metadata": "Secure string for 'credential' of 'GitHub_service'"
		},
		"AzureDataLakeStorage_Linkedservice_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://awstoragedatalake16.dfs.core.windows.net/"
		},
		"GitHub_service_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "Pratiksha769"
		},
		"Http_linkedservice_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://raw.githubusercontent.com"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "ad-aw-project-dolly_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureDataLakeStorage_Linkedservice_accountKey": {
						"value": "[parameters('AzureDataLakeStorage_Linkedservice_accountKey')]"
					},
					"GitHub_service_credential": {
						"value": "[parameters('GitHub_service_credential')]"
					},
					"AzureDataLakeStorage_Linkedservice_properties_typeProperties_url": {
						"value": "[parameters('AzureDataLakeStorage_Linkedservice_properties_typeProperties_url')]"
					},
					"GitHub_service_properties_typeProperties_username": {
						"value": "[parameters('GitHub_service_properties_typeProperties_username')]"
					},
					"Http_linkedservice_properties_typeProperties_url": {
						"value": "[parameters('Http_linkedservice_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}